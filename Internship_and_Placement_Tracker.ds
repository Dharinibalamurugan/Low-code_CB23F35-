				(
					display = total,average,min,max	
				)
				min_cgpa as "Minimum CGPA"
				eligible_departments as "Eligible Departments"
				graduation_year as "Graduation Year"
				max_backlogs as "Maximum Permitted Backlogs"
				required_skills as "Required Skills"
				application_deadline as "Application Deadline"
				drive_date as "Drive Date"
				selection_process as "Selection Process"
				drive_status as "Drive Status"
				created_by as "Created By"
				created_date as "Created Date"
			)
			options
			(
	 			display field = drive_status
	 		)
		}
		list student_details_Report
		{
			displayName = "All Student Details"
			show all rows from student_details    
			(
				student_id as "Student ID"
				full_name  as "Full Name"
				register_number as "Register Number"
				email as "Email Address"
				phone as "Phone Number"
				department as "Department"
				year_of_study as "Year of Study"
				graduation_year as "Graduation Year"
				cgpa as "CGPA"
				backlog_count as "Backlog Count"
				technical_skills as "Technical Skills"
				soft_skills as "Soft Skills"
				certifications as "Certifications"
				projects as "Projects"
				linkedin_url as "LinkedIn Profile"
				github_url as "GitHub Profile"
				resume as "Resume"
				profile_completeness as "Profile Completeness"
				(
					display = total,average,min,max	
				)
				account_status as "Account Status"
				assigned_faculty as "Assigned Faculty Mentor"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (year_of_study == "Final Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (year_of_study == "First Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (year_of_study == "Second Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (year_of_study == "Third Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban student_details_by_year_of_study
		{
			displayName = "Student Details Board"
			show all rows from student_details    
			(
				student_id as "Student ID"
				full_name  as "Full Name"
				register_number as "Register Number"
				email as "Email Address"
				phone as "Phone Number"
				department as "Department"
				year_of_study as "Year of Study"
				graduation_year as "Graduation Year"
				cgpa as "CGPA"
				backlog_count as "Backlog Count"
				technical_skills as "Technical Skills"
				soft_skills as "Soft Skills"
				certifications as "Certifications"
				projects as "Projects"
				linkedin_url as "LinkedIn Profile"
				github_url as "GitHub Profile"
				resume as "Resume"
				profile_completeness as "Profile Completeness"
				(
					display = total,average,min,max	
				)
				account_status as "Account Status"
				assigned_faculty as "Assigned Faculty Mentor"
			)
			options
			(
	 			display field = year_of_study
	 		)
		}
		list application_status_history_Report
		{
			displayName = "All Application Status Histories"
			show all rows from application_status_history    
			(
				history_id as "History ID"
				application as "Application"
				previous_status as "Previous Status"
				new_status as "New Status"
				changed_by as "Changed By"
				change_date as "Change Date"
				remarks as "Remarks"
			)
		}
		list company_details_Report
		{
			displayName = "Company Details Report"
			show all rows from company_details    
			(
				company_id as "Company ID"
				company_name as "Company Name"
				industry as "Industry"
				website as "Website"
				headquarters  as "Headquarters Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				company_description as "Company Description"
				hr_contact_name  as "HR Contact Name"
				hr_email as "HR Email"
				hr_phone as "HR Phone"
				company_status as "Company Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (company_status == "Active")
				fields = [company_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (company_status == "Inactive")
				fields = [company_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban company_details_by_company_status
		{
			displayName = "Company Statuses"
			show all rows from company_details    
			(
				company_id as "Company ID"
				company_name as "Company Name"
				industry as "Industry"
				website as "Website"
				headquarters  as "Headquarters Location"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				company_description as "Company Description"
				hr_contact_name  as "HR Contact Name"
				hr_email as "HR Email"
				hr_phone as "HR Phone"
				company_status as "Company Status"
			)
			options
			(
	 			display field = company_status
	 		)
		}
	}
