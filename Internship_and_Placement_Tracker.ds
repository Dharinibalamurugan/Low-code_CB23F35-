/*
 * Project      : Internship and Placement Tracker
 * Platform     : Zoho Creator
 * Created with : Zia AI-assisted application builder
 * Version      : 1.0
 *
 * NOTE:
 * This is a GitHub-friendly source-style reference based on the project
 * structure and fields discussed during development. It is not a verified
 * native export from the user's Zoho Creator account. Field link names and
 * platform-specific syntax should be checked against the actual app before
 * attempting to import or deploy it.
 */

application "Internship and Placement Tracker"
{
    date format = "dd-MMM-yyyy"
    time zone = "Asia/Kolkata"
    time format = "24-hr"

    forms
    {
        form Student_Profile
        {
            displayname = "Student Profile"
            success message = "Student Profile Added Successfully"

            Student_ID
            (
                type = autonumber
                displayname = "Student ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Full_Name
            (
                type = name
                displayname = "Full Name"
                row = 1
                column = 1
                width = medium
            )
            Register_Number
            (
                type = text
                displayname = "Register Number"
                row = 1
                column = 1
                width = medium
            )
            Email
            (
                type = email
                displayname = "Email"
                row = 1
                column = 1
                width = medium
                personal data = true
            )
            Mobile_Number
            (
                type = phonenumber
                displayname = "Mobile Number"
                row = 1
                column = 1
                width = medium
                personal data = true
            )
            Department
            (
                type = picklist
                displayname = "Department"
                values = {"AIML","CSE","ECE","IT","EEE","Mechanical","Civil","Other"}
                others option = true
                row = 1
                column = 1
                width = medium
            )
            Year_of_Study
            (
                type = picklist
                displayname = "Year of Study"
                values = {"First Year","Second Year","Third Year","Fourth Year"}
                row = 1
                column = 1
                width = medium
            )
            CGPA
            (
                type = decimal
                displayname = "CGPA"
                row = 1
                column = 1
                width = medium
            )
            Graduation_Year
            (
                type = number
                displayname = "Graduation Year"
                row = 1
                column = 1
                width = medium
            )
            Resume_URL
            (
                type = url
                displayname = "Resume URL"
                row = 1
                column = 1
                width = medium
            )
        }

        form Company_Profile
        {
            displayname = "Company Profile"
            success message = "Company Profile Added Successfully"

            Company_ID
            (
                type = autonumber
                displayname = "Company ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Company_Name
            (
                type = text
                displayname = "Company Name"
                row = 1
                column = 1
                width = medium
            )
            Industry
            (
                type = picklist
                displayname = "Industry"
                values = {"Information Technology","AI and Data Science","Finance","Healthcare","Education","Manufacturing","Other"}
                others option = true
                row = 1
                column = 1
                width = medium
            )
            Company_Email
            (
                type = email
                displayname = "Company Email"
                row = 1
                column = 1
                width = medium
            )
            Contact_Number
            (
                type = phonenumber
                displayname = "Contact Number"
                row = 1
                column = 1
                width = medium
            )
            Website
            (
                type = url
                displayname = "Website"
                row = 1
                column = 1
                width = medium
            )
            Location
            (
                type = text
                displayname = "Location"
                row = 1
                column = 1
                width = medium
            )
            Company_Description
            (
                type = textarea
                displayname = "Company Description"
                row = 1
                column = 1
                width = medium
            )
        }

        form Internship_Opportunity
        {
            displayname = "Internship Opportunity"
            success message = "Internship Opportunity Added Successfully"

            Internship_ID
            (
                type = autonumber
                displayname = "Internship ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Internship_Title
            (
                type = text
                displayname = "Internship Title"
                row = 1
                column = 1
                width = medium
            )
            Company_Name
            (
                type = text
                displayname = "Company Name"
                row = 1
                column = 1
                width = medium
            )
            Domain
            (
                type = picklist
                displayname = "Domain"
                values = {"Artificial Intelligence","Machine Learning","Web Development","Data Science","Cloud Computing","Cybersecurity","Other"}
                others option = true
                row = 1
                column = 1
                width = medium
            )
            Description
            (
                type = textarea
                displayname = "Description"
                row = 1
                column = 1
                width = medium
            )
            Location
            (
                type = text
                displayname = "Location"
                row = 1
                column = 1
                width = medium
            )
            Work_Mode
            (
                type = picklist
                displayname = "Work Mode"
                values = {"Remote","On-site","Hybrid"}
                row = 1
                column = 1
                width = medium
            )
            Stipend
            (
                type = INR
                displayname = "Stipend"
                row = 1
                column = 1
                width = medium
            )
            Duration
            (
                type = text
                displayname = "Duration"
                row = 1
                column = 1
                width = medium
            )
            Eligibility_Criteria
            (
                type = textarea
                displayname = "Eligibility Criteria"
                row = 1
                column = 1
                width = medium
            )
            Application_Deadline
            (
                type = date
                displayname = "Application Deadline"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Internship_Status
            (
                type = picklist
                displayname = "Internship Status"
                values = {"Open","Closed","Expired"}
                row = 1
                column = 1
                width = medium
            )
            Application_Link
            (
                type = url
                displayname = "Application Link"
                row = 1
                column = 1
                width = medium
            )
        }

        form Placement_Opportunity
        {
            displayname = "Placement Opportunity"
            success message = "Placement Opportunity Added Successfully"

            Placement_ID
            (
                type = autonumber
                displayname = "Placement ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Job_Title
            (
                type = text
                displayname = "Job Title"
                row = 1
                column = 1
                width = medium
            )
            Company_Name
            (
                type = text
                displayname = "Company Name"
                row = 1
                column = 1
                width = medium
            )
            Job_Description
            (
                type = textarea
                displayname = "Job Description"
                row = 1
                column = 1
                width = medium
            )
            Required_Skills
            (
                type = textarea
                displayname = "Required Skills"
                row = 1
                column = 1
                width = medium
            )
            Minimum_CGPA
            (
                type = decimal
                displayname = "Minimum CGPA"
                row = 1
                column = 1
                width = medium
            )
            Salary_Package_LPA
            (
                type = decimal
                displayname = "Salary Package (LPA)"
                row = 1
                column = 1
                width = medium
            )
            Job_Location
            (
                type = text
                displayname = "Job Location"
                row = 1
                column = 1
                width = medium
            )
            Job_Type
            (
                type = picklist
                displayname = "Job Type"
                values = {"Full-time","Part-time","Contract"}
                row = 1
                column = 1
                width = medium
            )
            Application_Deadline
            (
                type = date
                displayname = "Application Deadline"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Placement_Status
            (
                type = picklist
                displayname = "Placement Status"
                values = {"Open","Closed","Expired"}
                row = 1
                column = 1
                width = medium
            )
            Application_Link
            (
                type = url
                displayname = "Application Link"
                row = 1
                column = 1
                width = medium
            )
        }

        form Application_Record
        {
            displayname = "Application Record"
            success message = "Application Record Added Successfully"

            Application_ID
            (
                type = autonumber
                displayname = "Application ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Student_Name
            (
                type = text
                displayname = "Student Name"
                row = 1
                column = 1
                width = medium
            )
            Opportunity_Type
            (
                type = picklist
                displayname = "Opportunity Type"
                values = {"Internship","Placement"}
                row = 1
                column = 1
                width = medium
            )
            Opportunity_Title
            (
                type = text
                displayname = "Opportunity Title"
                row = 1
                column = 1
                width = medium
            )
            Company_Name
            (
                type = text
                displayname = "Company Name"
                row = 1
                column = 1
                width = medium
            )
            Application_Date
            (
                type = date
                displayname = "Application Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Application_Status
            (
                type = picklist
                displayname = "Application Status"
                values = {"Submitted","Under Review","Shortlisted","Interview Scheduled","Selected","Rejected","Withdrawn"}
                row = 1
                column = 1
                width = medium
            )
            Interview_Date
            (
                type = date
                displayname = "Interview Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Remarks
            (
                type = textarea
                displayname = "Remarks"
                row = 1
                column = 1
                width = medium
            )
        }

        form Interview_Schedule
        {
            displayname = "Interview Schedule"
            success message = "Interview Schedule Added Successfully"

            Interview_ID
            (
                type = autonumber
                displayname = "Interview ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Student_Name
            (
                type = text
                displayname = "Student Name"
                row = 1
                column = 1
                width = medium
            )
            Company_Name
            (
                type = text
                displayname = "Company Name"
                row = 1
                column = 1
                width = medium
            )
            Interview_Round
            (
                type = picklist
                displayname = "Interview Round"
                values = {"Aptitude Test","Technical Interview","HR Interview","Final Interview"}
                row = 1
                column = 1
                width = medium
            )
            Interview_Date
            (
                type = date
                displayname = "Interview Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Interview_Time
            (
                type = time
                displayname = "Interview Time"
                row = 1
                column = 1
                width = medium
            )
            Interview_Mode
            (
                type = picklist
                displayname = "Interview Mode"
                values = {"Online","Offline"}
                row = 1
                column = 1
                width = medium
            )
            Interview_Link
            (
                type = url
                displayname = "Interview Link"
                row = 1
                column = 1
                width = medium
            )
            Interview_Result
            (
                type = picklist
                displayname = "Interview Result"
                values = {"Pending","Cleared","Not Cleared"}
                row = 1
                column = 1
                width = medium
            )
            Feedback
            (
                type = textarea
                displayname = "Feedback"
                row = 1
                column = 1
                width = medium
            )
        }

        form Student_Skill
        {
            displayname = "Student Skill"
            success message = "Student Skill Added Successfully"

            Skill_ID
            (
                type = autonumber
                displayname = "Skill ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Student_Name
            (
                type = text
                displayname = "Student Name"
                row = 1
                column = 1
                width = medium
            )
            Skill_Name
            (
                type = text
                displayname = "Skill Name"
                row = 1
                column = 1
                width = medium
            )
            Proficiency_Level
            (
                type = picklist
                displayname = "Proficiency Level"
                values = {"Beginner","Intermediate","Advanced"}
                row = 1
                column = 1
                width = medium
            )
            Certification_Name
            (
                type = text
                displayname = "Certification Name"
                row = 1
                column = 1
                width = medium
            )
            Issuing_Organization
            (
                type = text
                displayname = "Issuing Organization"
                row = 1
                column = 1
                width = medium
            )
            Completion_Date
            (
                type = date
                displayname = "Completion Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Certificate_URL
            (
                type = url
                displayname = "Certificate URL"
                row = 1
                column = 1
                width = medium
            )
        }

        form Internship_Record
        {
            displayname = "Internship Record"
            success message = "Internship Record Added Successfully"

            Record_ID
            (
                type = autonumber
                displayname = "Record ID"
                start index = 1
                row = 1
                column = 1
                width = medium
            )
            Student_Name
            (
                type = text
                displayname = "Student Name"
                row = 1
                column = 1
                width = medium
            )
            Internship_Title
            (
                type = text
                displayname = "Internship Title"
                row = 1
                column = 1
                width = medium
            )
            Start_Date
            (
                type = date
                displayname = "Start Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            End_Date
            (
                type = date
                displayname = "End Date"
                alloweddays = 0,1,2,3,4,5,6
                row = 1
                column = 1
                width = medium
            )
            Mentor_Name
            (
                type = text
                displayname = "Mentor Name"
                row = 1
                column = 1
                width = medium
            )
            Completion_Status
            (
                type = picklist
                displayname = "Completion Status"
                values = {"Not Started","In Progress","Completed","Discontinued"}
                row = 1
                column = 1
                width = medium
            )
            Certificate_URL
            (
                type = url
                displayname = "Certificate URL"
                row = 1
                column = 1
                width = medium
            )
            Feedback
            (
                type = textarea
                displayname = "Feedback"
                row = 1
                column = 1
                width = medium
            )
        }
    }

    reports
    {
        list Student_Profiles_Report
        {
            displayName = "All Student Profiles"
            show all rows from Student_Profile
            (
                Student_ID as "Student ID"
                Full_Name as "Full Name"
                Register_Number as "Register Number"
                Email as "Email"
                Department as "Department"
                Year_of_Study as "Year of Study"
                CGPA as "CGPA"
                Graduation_Year as "Graduation Year"
            )
        }
        list Company_Profiles_Report
        {
            displayName = "All Company Profiles"
            show all rows from Company_Profile
            (
                Company_ID as "Company ID"
                Company_Name as "Company Name"
                Industry as "Industry"
                Company_Email as "Company Email"
                Location as "Location"
                Website as "Website"
            )
        }
        list Internship_Opportunities_Report
        {
            displayName = "All Internship Opportunities"
            show all rows from Internship_Opportunity
            (
                Internship_ID as "Internship ID"
                Internship_Title as "Internship Title"
                Company_Name as "Company"
                Domain as "Domain"
                Work_Mode as "Work Mode"
                Stipend as "Stipend"
                Duration as "Duration"
                Application_Deadline as "Application Deadline"
                Internship_Status as "Status"
            )
        }
        list Placement_Opportunities_Report
        {
            displayName = "All Placement Opportunities"
            show all rows from Placement_Opportunity
            (
                Placement_ID as "Placement ID"
                Job_Title as "Job Title"
                Company_Name as "Company"
                Minimum_CGPA as "Minimum CGPA"
                Salary_Package_LPA as "Salary Package (LPA)"
                Job_Location as "Location"
                Application_Deadline as "Application Deadline"
                Placement_Status as "Status"
            )
        }
        list Application_Records_Report
        {
            displayName = "All Application Records"
            show all rows from Application_Record
            (
                Application_ID as "Application ID"
                Student_Name as "Student"
                Opportunity_Type as "Opportunity Type"
                Opportunity_Title as "Opportunity"
                Company_Name as "Company"
                Application_Date as "Application Date"
                Application_Status as "Application Status"
                Interview_Date as "Interview Date"
            )
        }
        kanban Applications_By_Status
        {
            displayName = "Applications by Status"
            show all rows from Application_Record
            (
                Student_Name as "Student"
                Opportunity_Type as "Opportunity Type"
                Opportunity_Title as "Opportunity"
                Company_Name as "Company"
                Application_Date as "Application Date"
                Application_Status as "Application Status"
            )
            options
            (
                display field = Application_Status
            )
        }
        list Interview_Schedules_Report
        {
            displayName = "Interview Schedules"
            show all rows from Interview_Schedule
            (
                Interview_ID as "Interview ID"
                Student_Name as "Student"
                Company_Name as "Company"
                Interview_Round as "Interview Round"
                Interview_Date as "Interview Date"
                Interview_Time as "Interview Time"
                Interview_Mode as "Interview Mode"
                Interview_Result as "Result"
            )
        }
        list Student_Skills_Report
        {
            displayName = "Student Skills"
            show all rows from Student_Skill
            (
                Skill_ID as "Skill ID"
                Student_Name as "Student"
                Skill_Name as "Skill"
                Proficiency_Level as "Proficiency Level"
                Certification_Name as "Certification"
                Issuing_Organization as "Issuing Organization"
                Completion_Date as "Completion Date"
            )
        }
        list Internship_Records_Report
        {
            displayName = "Internship Records"
            show all rows from Internship_Record
            (
                Record_ID as "Record ID"
                Student_Name as "Student"
                Internship_Title as "Internship"
                Start_Date as "Start Date"
                End_Date as "End Date"
                Mentor_Name as "Mentor"
                Completion_Status as "Completion Status"
            )
        }
    }

    customize
    {
        icon
        {
            text = "IPT"
            background color = "theme"
            foreground color = "#ffffff"
        }
    }
}
