	reports
	{
		list applications_Report
		{
			displayName = "All Applications"
			show all rows from applications    
			(
				application_id as "Application ID"
				student as "Student"
				opportunity_type as "Opportunity Type"
				internship as "Internship"
				placement_drive as "Placement Drive"
				application_date as "Application Date"
				submitted_resume as "Submitted Resume"
				current_status as "Current Status"
				eligibility_status as "Eligibility Status"
				eligibility_reasons as "Eligibility Reasons"
				remarks as "Remarks"
				last_updated as "Last Updated"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (eligibility_status == "Eligible")
				fields = [eligibility_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (eligibility_status == "Ineligible")
				fields = [eligibility_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (eligibility_status == "Pending")
				fields = [eligibility_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban applications_by_current_status
		{
			displayName = "Current Statuses"
			show all rows from applications    
			(
				application_id as "Application ID"
				student as "Student"
				opportunity_type as "Opportunity Type"
				internship as "Internship"
				placement_drive as "Placement Drive"
				application_date as "Application Date"
				submitted_resume as "Submitted Resume"
				current_status as "Current Status"
				eligibility_status as "Eligibility Status"
