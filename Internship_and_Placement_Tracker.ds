 application "Internship and Placement Tracker"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form application_status_history
		{
			displayname = "Application Status History"
			success message = "Application Status History Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			history_id
			(
    			type = autonumber
				displayname = "History ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have application
			(
				type = picklist	
				displayname = "Application"
				values  = applications.ID
    			displayformat = [application_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_status
			(
    			type = text
				displayname = "Previous Status"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have new_status
			(
    			type = text
				displayname = "New Status"
	 			row = 1
	 			column = 1   
				width = medium
			)
			changed_by
			(
    			type = picklist
				displayname = "Changed By"
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have change_date
			(
    			type = datetime
				displayname = "Change Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form applications
		{
			displayname = "Applications"
			success message = "Applications Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			application_id
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have student
			(
				type = picklist	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have opportunity_type
			(
				type = picklist
				displayname = "Opportunity Type"
				values = {"Placement Drive","Internship"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			internship
			(
				type = picklist	
				displayname = "Internship"
				values  = internship_opportunities.ID
    			displayformat = [internship_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			placement_drive
			(
				type = picklist	
				displayname = "Placement Drive"
				values  = placement_drives.ID
    			displayformat = [drive_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have application_date
			(
    			type = datetime
				displayname = "Application Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			submitted_resume
			(
    			type = upload file
				displayname = "Submitted Resume"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have current_status
			(
				type = picklist
				displayname = "Current Status"
				values = {"Shortlisted","Under Review","Assessment Scheduled","Interview Scheduled","Withdrawn","Selected","Rejected","Applied"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			eligibility_status
			(
				type = picklist
				displayname = "Eligibility Status"
				values = {"Ineligible","Eligible","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			eligibility_reasons
			(
    			type = textarea
				displayname = "Eligibility Reasons"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form company_details
		{
			displayname = "Company Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			company_id
			(
    			type = autonumber
				displayname = "Company ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique company_name
			(
    			type = text
				displayname = "Company Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			industry
			(
				type = picklist
				displayname = "Industry"
				values = {"Retail","Energy","Technology","Education","Finance","Consulting","Media","Healthcare","Manufacturing","Telecommunications","Automotive","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			website
			(
    			type = url
				displayname = "Website"
	 			row = 1
	 			column = 1   
				width = medium
			)
			headquarters
			(
    			type = address
				displayname = "Headquarters Location"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			company_description
			(
    			type = textarea
				displayname = "Company Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			hr_contact_name
			(
    			type = name
				displayname = "HR Contact Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			hr_email
			(
    			type = email
				displayname = "HR Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			hr_phone
			(
    			type = phonenumber
				displayname = "HR Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			company_status
			(
				type = picklist
				displayname = "Company Status"
				values = {"Prospective","Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form internship_opportunities
		{
			displayname = "Internship Opportunities"
			success message = "Internship Opportunities Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			internship_id
			(
    			type = autonumber
				displayname = "Internship ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have company
			(
				type = picklist	
				displayname = "Company"
				values  = company_details.ID
    			displayformat = [company_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have title
			(
    			type = text
				displayname = "Internship Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			domain
			(
				type = picklist
				displayname = "Domain"
				values = {"Data Science","Software Development","DevOps","Cloud Computing","Mobile Development","UI/UX Design","Cybersecurity","Digital Marketing","Machine Learning","Web Development","Business Analysis","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			required_skills
			(
				type = list	
				displayname = "Required Skills"
				values = {"Java","C++","Mobile Development","Node.js","Cybersecurity","React","Machine Learning","Angular","SQL","Data Science","DevOps","Cloud Computing","HTML/CSS","JavaScript","Python","Other"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have duration_months
			(
				type = number
				displayname = "Duration (Months)"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			stipend
			(
				displayname = "Stipend Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			min_cgpa
			(
				type = decimal
				displayname = "Minimum CGPA"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			eligible_departments
			(
				type = list	
				displayname = "Eligible Departments"
				values = {"Biotechnology","Civil","Electronics & Communication","Chemical","Computer Science","Mechanical","Electrical","Business Administration","Management","Information Technology","Art & Design","Other"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			graduation_year_requirement
			(
    			type = text
				displayname = "Graduation Year Requirement"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have application_deadline
			(
    			type = date
				displayname = "Application Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_link
			(
    			type = url
				displayname = "Application Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			publication_status
			(
				type = picklist
				displayname = "Publication Status"
				values = {"Draft","Closed","Published","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = picklist
				displayname = "Created By"
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form interview_management
		{
			displayname = "Interview Management"
			success message = "Interview Management Added Successfully"
